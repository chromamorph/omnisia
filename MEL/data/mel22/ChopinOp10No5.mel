MEL22;
triadStruc = maskStructure(2,2,3);
GfMaMask = mask(6,2,2,1,2,2,2,1);
fifthInTriadMask = mask(0,2,1);
fourthInTriadMask = mask(2,1,2);
evenNumMaskSeq = maskSequence(mask(0,2)); 
tonicTriadMask = mask(0,triadStruc);
subdomTriadMask = mask(3,triadStruc);
domTriadMask = mask(4,triadStruc);
supertonicTriadMask = mask(1,triadStruc);
GfMaTonTriadMaskSeq = maskSequence(GfMaMask,tonicTriadMask); 
unitMaskSeq = maskSequence(mask(0,1));
GfMaSubdomTriadMaskSeq = maskSequence(GfMaMask,subdomTriadMask);
GfMaDomFifthMaskSeq = maskSequence(GfMaMask,domTriadMask,fifthInTriadMask);
GfMaII64FifthMaskSeq = maskSequence(GfMaMask,supertonicTriadMask,fourthInTriadMask);
S1 = space(unitMaskSeq,GfMaDomFifthMaskSeq);
S2 = space(unitMaskSeq,GfMaII64FifthMaskSeq);
n = coords(1,1);
p = coords(1,-1);
n1 = note(0,90);
n2 = note(4,87); 
n3 = note(6,85);
n4 = note(24,61);
n5 = note(36,75);
v0 = vector(0,0);
v1 = vector(p,evenNumMaskSeq,GfMaTonTriadMaskSeq);
v2 = vector(n,unitMaskSeq,GfMaTonTriadMaskSeq);
v3 = vector(n,unitMaskSeq,GfMaSubdomTriadMaskSeq);
v4 = vector(12,-12);
v5 = vector(48,0);
v6 = vector(92,0);
v7 = vector(1,2,S1);
v8 = vector(p,S1);
v9 = vectorSum(vector(6,7));
v10 = vector(1,2,S2);
v11 = vector(p,S2);
v12 = vector(6,5);
Q1 = vectorSequence(v0,v7,v8);
Q2 = vectorSequence(v0,v10,v11);
V1 = vectorAdd(vector(5,19),reflectPitch(reflectTime(Q1)));
V2 = union(Q1,V1);
V3 = vectorAdd(vector(5,17),reflectPitch(reflectTime(Q2)));
V4 = union(Q2,V3);
N1 = translate(n1,product(v1,v2));
N2 = translate(n2,vectorSet(v0,v3));
N3 = translate(n3,product(repeat(2,v1),v2));
N4 = translate(union(N1,N2,N3),product(v4,v5,v6));
N5 = translate(n4,product(V2,v9,v6));
N6 = translate(n5,product(V4,v12,v6));
add(N4,N5,N6);
draw();
print();
play(100);